{
  "$schema": "https://opencode.ai/schemas/opencode.json",
  "model": "opencode/big-pickle",
  "provider": {
    "opencode-zen": {
      "type": "opencode-zen",
      "apiKey": "${env:OPENCODE_ZEN_API_KEY}"
    }
  },
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "bash": {
      "./mvnw test*": "allow",
      "./mvnw verify": "allow",
      "docker compose*": "allow",
      "rm -rf*": "deny",
      "git push --force*": "deny"
    },
    "edit": {
      ".github/workflows/**": "deny",
      "**/*.env*": "deny",
      "**/secrets/**": "deny"
    }
  },
  "mcp": {
    "finbank-mcp": {
      "type": "local",
      "command": [
        "python",
        "./finbank-mcp/server.py"
      ],
      "enabled": true
    }
  }
}